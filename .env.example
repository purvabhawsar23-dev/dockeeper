# Copy this file to .env and fill in real values.
# .env is listed in .gitignore so secrets are never committed to git.

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=dockeeper
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_key_here

# Embedding model settings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=50
EMBED_TOKENS_PER_MINUTE=25000

# Chat model settings
CHAT_MODEL=gemini-2.0-flash

# OCR model settings
OCR_MODEL=gemini-2.0-flash
OCR_REQUESTS_PER_MINUTE=10

# Retrieval / ranking settings
RETRIEVE_K=30          # candidates fetched from each search arm before merging
FINAL_K=8              # results kept after RRF re-ranking
RRF_K=60               # RRF smoothing constant (higher = less weight to top ranks)
MIN_SIMILARITY=0.58    # minimum vector similarity to pass the relevance gate
MAX_CONTEXT_CHARS=24000  # hard cap on total characters sent to the LLM
